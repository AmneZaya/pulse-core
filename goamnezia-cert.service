[Unit]
Description=goAmnezia pro — срок сертификата сайта (раз в сутки)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Environment=GOAMNEZIA_WHO=timer
TimeoutStartSec=30min
ExecStart=/bin/bash /opt/goamnezia/install.sh --action=cert-tick --json
